{
  "extends": [
    "../_common/sparse_methods.json"
  ],
  "pipeline_params": {
    "chat_template": "qwen",
    "model_max_len": 32768,
    "model_name": "modelzoo/Qwen2.5-32B-Instruct",
    "tokenizer_name": "modelzoo/Qwen2.5-32B-Instruct",
    "truncation_mode": "middle",
    "earlyselectkv": {
      "lookahead_mid_until_layer": 40,
      "skip_layers": 1
    },
    "earlyselectkv_in": {
      "lookahead_mid_until_layer": 40,
      "skip_layers": 1
    },
    "earlyselectkv_in_mid": {
      "lookahead_source": "in_mid",
      "lookahead_mid_until_layer": 40,
      "skip_layers": 1
    },
    "earlyselect_quest": {
      "lookahead_mid_until_layer": 40,
      "skip_layers": 1
    }
  }
}
